{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuotaDial",
  "version": "0.1.1",
  "identifier": "space.cyhao.yetform.quotadial",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaDial",
        "width": 1220,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "tray-panel",
        "title": "QuotaDial",
        "url": "index.html?view=tray",
        "width": 360,
        "height": 496,
        "minWidth": 360,
        "minHeight": 496,
        "maxWidth": 360,
        "maxHeight": 496,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
